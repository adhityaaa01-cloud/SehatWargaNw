# Development only. Replace placeholders locally; never commit .env.
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/sehatwarga
AI_PROVIDER=fallback
AI_API_KEY=
AI_MODEL=
# To enable Gemini: AI_PROVIDER=gemini, AI_API_KEY=your-private-key,
# AI_MODEL=a-supported-model-from-your-Gemini-account

# To enable Groq: AI_PROVIDER=groq (AI_API_KEY is not required)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Ollama existing adapter: timeout uses seconds (35, not 35000).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_TIMEOUT_SECONDS=35

# Public browser token for Mapbox maps and temporary facility search.
MAPBOX_PUBLIC_TOKEN=

# Optional Google Maps browser key, restricted to the site referrers.
GOOGLE_PLACES_BROWSER_KEY=
